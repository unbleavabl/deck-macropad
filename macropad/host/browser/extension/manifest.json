{
  "manifest_version": 3,
  "name": "deckd tab volume",
  "version": "1.0",
  "description": "Lets the macropad's focused-app slider set the volume of the media in the active tab of the focused window.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
